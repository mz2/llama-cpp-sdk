#!/usr/bin/bash
# Runs as root on launch and refresh.
# Puts the llama.cpp tools on PATH and makes the bundled shared libraries
# discoverable, regardless of which backend channel is installed.
set -eu

ROOT="${SDK}/opt/llama.cpp"

# The upstream tarballs (cpu, vulkan) are flat: executables and *.so live in
# one directory. The canonical builds (cuda, rocm) split them into bin/ and
# lib/. Detect the layout and configure PATH / ld.so accordingly.
if [ -d "${ROOT}/bin" ]; then
    BINDIR="${ROOT}/bin"
    LIBDIRS="${ROOT}/bin ${ROOT}/lib"
else
    BINDIR="${ROOT}"
    LIBDIRS="${ROOT}"
fi

cat <<EOF >/etc/profile.d/llama-cpp.sh
export PATH="${BINDIR}:\$PATH"
EOF

: >/etc/ld.so.conf.d/llama-cpp.conf
for d in ${LIBDIRS}; do
    echo "${d}" >>/etc/ld.so.conf.d/llama-cpp.conf
done
ldconfig

# Install the runtime libraries the prebuilt binaries need but the base image
# lacks. Every backend's ggml-cpu library links OpenMP (libgomp); the upstream
# tarballs do not bundle it, so llama-cli fails with "libgomp.so.1: cannot open
# shared object file" without it. The ROCm build additionally needs libatomic;
# the Vulkan build needs the Vulkan loader and a userspace ICD (NVIDIA/AMD
# proprietary ICDs arrive via the `gpu` interface).
pkgs="libgomp1"
if find "${ROOT}" -name 'libggml-hip.so*' -print -quit | grep -q .; then
    pkgs="${pkgs} libatomic1"
fi
if find "${ROOT}" -name 'libggml-vulkan.so*' -print -quit | grep -q .; then
    pkgs="${pkgs} libvulkan1 mesa-vulkan-drivers vulkan-tools"
fi
apt-get update
# shellcheck disable=SC2086
eatmydata apt-get install ${pkgs}
